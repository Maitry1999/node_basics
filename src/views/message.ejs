<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat App</title>
    <script src="https://cdn.socket.io/4.0.0/socket.io.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-200 flex justify-center items-center min-h-screen">
    <div class="w-full max-w-4xl bg-white shadow-lg rounded-lg flex">

        <!-- Sidebar - User List -->
        <div class="w-1/3 border-r border-gray-300 p-4 bg-gray-100">
            <h2 class="text-xl font-bold text-blue-600">Chat App 💬</h2>
            <h3 class="mt-2 text-gray-600 font-semibold">Select a User</h3>
            <ul id="userList" class="mt-2 space-y-2 max-h-96 overflow-auto"></ul>
        </div>

        <!-- Chat Window -->
        <div class="w-2/3 flex flex-col">
            <div id="chatBox" class="hidden flex flex-col h-full">
                <div id="chatHeader" class="p-3 bg-blue-500 text-white text-lg font-bold rounded-t-lg">Chat</div>
                <ul id="messages" class="flex-1 p-4 overflow-auto bg-gray-50"></ul>
                <div class="p-3 bg-gray-100 border-t flex items-center gap-2">
                    <input id="message" class="flex-1 p-2 border rounded-lg" type="text"
                        placeholder="Type a message...">
                    <button onclick="sendMessage()"
                        class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600">Send</button>
                </div>
            </div>
        </div>

    </div>

    <script>
        const socket = io("http://localhost:4545", {
            reconnection: true,
            reconnectionAttempts: 5,
            reconnectionDelay: 2000
        });

        let senderId = localStorage.getItem("username");
        let receiverId = null;
        // Register user when the page loads
        socket.emit("register-user", senderId);
        document.addEventListener("DOMContentLoaded", fetchUsers);


        function fetchUsers() {
            const username = localStorage.getItem("username");
            fetch(`<%= baseUrl %>/users/getAllusers?username=${encodeURIComponent(username)}`)
                .then(res => res.json())
                .then(users => displayUsers(users.data))
                .catch(error => console.error("Error fetching users:", error));
        }

        function displayUsers(users) {
            const userList = document.getElementById("userList");
            userList.innerHTML = "";

            users.users.forEach(user => {
                const li = document.createElement("li");
                li.classList.add("cursor-pointer", "p-3", "bg-white", "shadow", "rounded-lg", "hover:bg-gray-200", "flex", "items-center", "gap-4");

                const img = document.createElement("img");
                img.src = user.profileImage || "https://via.placeholder.com/50";
                img.alt = "Profile";
                img.classList.add("w-10", "h-10", "rounded-full");

                const div = document.createElement("div");
                div.innerHTML = `<p class="text-lg font-semibold">${user.email}</p>`;

                li.addEventListener("click", () => openChat(user));
                li.appendChild(img);
                li.appendChild(div);
                userList.appendChild(li);
            });
        }

        function openChat(user) {
            receiverId = user._id;
            document.getElementById("chatHeader").textContent = `Chat with ${user.email}`;
            document.getElementById("chatBox").classList.remove("hidden");
            fetchMessages();
        }

        function fetchMessages() {
            fetch(`<%= baseUrl %>/chats/private/${senderId}/${receiverId}`)
                .then(res => res.json())
                .then(messages => {
                    const messageList = document.getElementById("messages");
                    messageList.innerHTML = "";
                    messages.data.forEach(msg => {
                        const li = document.createElement("li");
                        li.classList.add(
                            "p-3", "rounded-lg", "max-w-xs", "mb-2", "text-white",
                            ...(msg.senderId === senderId ? ["bg-blue-500", "ml-auto"] : ["bg-gray-400", "mr-auto"])
                        );

                        li.textContent = msg.message;
                        messageList.appendChild(li);
                    });
                })
                .catch(error => console.error("Error fetching messages:", error));
        }

        function sendMessage() {
            const message = document.getElementById("message").value;
            if (!message) return;

            socket.emit("private-message", { senderId, receiverId, message });

            const li = document.createElement("li");
            li.classList.add("p-3", "rounded-lg", "max-w-xs", "mb-2", "text-white", "bg-blue-500", "ml-auto");
            li.textContent = message;
            document.getElementById("messages").appendChild(li);

            document.getElementById("message").value = "";
        }

        // Listen for incoming private messages
        socket.on("private-message", (data) => {
            console.log("📨 New private message:", data);
            if (data.senderId !== senderId) {
                const messageList = document.getElementById("messages");
                const li = document.createElement("li");
                li.classList.add("p-3", "rounded-lg", "max-w-xs", "mb-2", "text-white", "bg-gray-400", "mr-auto");
                li.textContent = data.message;
                messageList.appendChild(li);
            }
        })
        // Handle connection events
        socket.on("connect", () => console.log("✅ Connected to socket server:", socket.id));
        socket.on("disconnect", () => console.log("❌ Disconnected from server"));
        socket.on("connect_error", (error) => console.error("⚠️ Connection error:", error));

    </script>
</body>

</html>