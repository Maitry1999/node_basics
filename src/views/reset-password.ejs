<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password</title>
    <style>
        /* General styles for the body */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        /* Container for the form */
        .container {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px 30px;
            max-width: 400px;
            text-align: center;
            width: 100%;
        }

        /* Heading style */
        .container h1 {
            font-size: 1.8rem;
            color: #333;
            margin-bottom: 20px;
        }

        /* Label styles */
        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            text-align: left;
        }

        /* Input fields */
        input[type="password"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
            box-sizing: border-box;
        }

        /* Button styles */
        button {
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #0056b3;
        }

        /* Link for additional info or error messages */
        p {
            margin-top: 10px;
            font-size: 0.9rem;
            color: #666;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Reset Your Password</h1>
        <form id="resetPasswordForm">
            <label for="newPassword">New Password:</label>
            <input type="password" id="newPassword" name="newPassword" required />

            <label for="confirmPassword">Confirm Password:</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required />

            <button type="button" id="resetPasswordButton">Reset Password</button>
        </form>
        <p id="errorMessage" style="color: red;"></p>
    </div>

    <script>
        // Handle form submission and API call for resetting password
        document.getElementById('resetPasswordButton').addEventListener('click', async function () {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const token = '<%= token %>';  // Token should be passed to the frontend and set here
            const errorMessageElement = document.getElementById('errorMessage');

            // Check if passwords match
            if (newPassword !== confirmPassword) {
                errorMessageElement.textContent = "Passwords do not match.";
                return;
            }

            console.log('newPassword:', newPassword);
            console.log('confirmPassword:', confirmPassword);
            console.log('token:', token);

            // console.log('process.env.BASE_URL:', process.env.BASE_URL);

            // Clear previous error message
            errorMessageElement.textContent = '';

            try {
                // API call to reset password with token passed in the header
                const response = await fetch(`http://localhost:3444/api/v1/users/reset-password`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`,  // Send token in Authorization header
                    },
                    body: JSON.stringify({
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    }),
                });
                console.log('response:', response);

                const data = await response.json();

                if (response.ok) {
                    alert('Password reset successfully.');
                    // Optionally, redirect to login page or other action
                    window.location.href = '/'; // Example redirect
                } else {
                    errorMessageElement.textContent = data.message || 'Failed to reset password.';
                }
            } catch (error) {
                console.error('Error:', error);
                errorMessageElement.textContent = 'An error occurred while resetting the password.';
            }
        });
    </script>
</body>

</html>